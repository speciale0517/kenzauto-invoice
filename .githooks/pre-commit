#!/bin/sh
# CLAUDE.mdの変更履歴が肥大化していないか警告する（commitは止めない）
if [ -f "CLAUDE.md" ]; then
  ROWS=$(awk '/^## 変更履歴/{f=1;next} /^## /{f=0} f && /^\| *20[0-9][0-9]-[0-9][0-9]-[0-9][0-9] *\|/{c++} END{print c+0}' CLAUDE.md)
  THRESHOLD=20
  if [ "$ROWS" -gt "$THRESHOLD" ]; then
    echo ""
    echo "⚠️  CLAUDE.mdの変更履歴が${ROWS}件になっています(閾値${THRESHOLD}件)。"
    echo "   古い履歴をCLAUDE.md.history.mdへアーカイブ分離することを検討してください。"
    echo ""
  fi
fi

# tests/ があるプロジェクトだけ、commit前にPlaywrightで検証する
if [ -f "playwright.config.js" ] && [ -d "node_modules" ]; then
  npx playwright test
  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Playwrightテストが失敗しました。commitを中止します。"
    echo "   修正するか、緊急時のみ git commit --no-verify で回避できます。"
    exit 1
  fi
elif [ -f "playwright.config.js" ]; then
  echo "⚠️  tests/ はありますが node_modules がありません(npm install未実行)。今回のcommitはテスト未実行のまま進みます。"
fi
exit 0
